{
  "name": "ai-travel-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/local.ts",
    "test": "tsx --env-file-if-exists=.env --test test/*.test.ts",
    "test:offline": "tsx --env-file-if-exists=.env --test --test-skip-pattern='network' test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "serve": "tsx --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "verify:bundle": "./scripts/verify-bundle.sh"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1113.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1113.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
